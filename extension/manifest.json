{
  "manifest_version": 3,
  "name": "PDF Save Timer for Edge",
  "version": "2.0.0",
  "description": "Automatically requests Ctrl+S while a PDF is active in Edge. Adjustable interval, no native helper.",
  "minimum_chrome_version": "118",
  "permissions": [
    "storage",
    "tabs",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDF Save Timer",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "file:///*"
  ]
}
